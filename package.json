{
    "name": "sme-analytics-automation",
    "version": "1.0.0",
    "description": "Automation project using Playwright",
    "main": "index.js",
    "scripts": {
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:debug": "playwright test --debug",
        "test:ui": "playwright test --ui",
        "test:report": "playwright show-report",
        "test:chrome": "playwright test --project=chromium",
        "test:reports": "playwright test tests/smeAnalytics/Reports.spec.js tests/smeAnalytics/Reports-actions.spec.js tests/smeAnalytics/Reports.z-cleanup.spec.js --grep @reports"
    },
    "keywords": [
        "playwright",
        "automation",
        "testing"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@playwright/test": "^1.59.1"
    }
}
